# Install and load ggplot2
install.packages("ggplot2")
library(ggplot2)

# Import dataset
data <- read.csv(file.choose())

# View the dataset
head(data)


# Create scatter plot
ggplot(data, aes(x = Age, y = Height_cm, color = Gender)) +
    geom_point(size = 3) +
    geom_smooth(method = "lm", se = TRUE) +
    labs(
        title = "Relationship Between Age and Height by Gender",
        x = "Age (years)",
        y = "Height (cm)",
        color = "Gender"
    ) +
    theme_minimal()



# Save the plot
ggsave("Weight_Height_Scatterplot.png",
       width = 8, height = 6, dpi = 300)
